pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
--nonograms celebrating pico8
--by uvehj
puzzle = {}
menustate = 1
state = 0
cursorpos = {0,0}
selectedsize = {7,5}
wins = {}
checkcounter = 30
totalpuzzles = 24
currentpuzzle = 1
cooldown = 0
band = {objective=30,position=30,defaults={30,-75}, speed=600}
function _init()
    poke(0x5f2e, 1)
    pal(3, -3, 1)
    pal(11, -8, 1)
    pal(9, -7, 1)
    pal(15, -14, 1)
    pal(14, -4, 1)
    state = 0
    totalpuzzles = #get_levels()
    cartdata("uvehjvnonogramshltb")
    local i = 1
    while i <= totalpuzzles do
        wins[i] = dget(i)
        i += 1
    end
    menuitem(1, "delete progress", delete_progress)
end

function delete_progress()
    local i = 1
    while i <= totalpuzzles do
        wins[i] = 0
        dset(i,0)
        i += 1
    end
end
function _draw()
    cls(8)

    if state == 1 then
        draw_band()
        draw_board(puzzle.x,puzzle.y)
        draw_cursor(puzzle.x,puzzle.y)
    elseif state == 2 then
        draw_band()
        draw_board(puzzle.x,puzzle.y)
        draw_win()
    elseif state == 0 then
        draw_band()
        draw_title()
    end
end
function _update60()
    update_band()
    if state == 1 then
        update_buttons_game()
        cooldown = max(0, cooldown - (1/60))
        checkcounter -= 1
        if checkcounter <= 0 then
            state = check_finished_and_autocomplete()
            checkcounter = 30
        end
    elseif state == 0 then
        
        update_buttons_menu()
    elseif state == 2 then
        cooldown = max(0, cooldown - (1/60))
        update_buttons_finish()
    end
end

function update_band()
    if(band.position<band.objective) then
        band.position = min(band.objective, band.position+(band.speed/60))
    elseif(band.position>band.objective) then
        band.position = max(band.objective, band.position-(band.speed/60))
    end
end

function create_puzzle(position,starttiles,endtiles)
    puzzle.width = 1+endtiles[1]-starttiles[1]
    puzzle.height = 1+endtiles[2]-starttiles[2]
    puzzle.mistakes=0
    puzzle.x = position[1]
    puzzle.y = position[2]
    puzzle.board = {}
    local x = 0
    local y = 0
    while x <= puzzle.width do
        y = 0
        local row = {}
        while y <= puzzle.height do
            if mget(starttiles[1]+x,starttiles[2]+y) == 3 then
                add(row,{1,0,0})
            else
                add(row,{0,0,0})
            end
            y += 1
        end
        add(puzzle.board,row)
        x += 1
    end
    puzzle.rownumbers = {}
    y = 1
    while y <= puzzle.height do
        x = 1
        local curnumber = 0
        local currow = {}
        while x <= puzzle.width do
            if curnumber != 0 and puzzle.board[x][y][1] == 0 then
                add(currow,curnumber)
                curnumber = 0
            end
            if puzzle.board[x][y][1] == 1 then
                curnumber += 1
            end
            x += 1
        end
        if curnumber != 0 then
            add(currow,curnumber)
        end
        add(puzzle.rownumbers,currow)
        y += 1
    end
    puzzle.columnnumbers = {}
    x = 1
    while x <= puzzle.width do
        y = 1
        local curnumber = 0
        local curcolumn = {}
        while y <= puzzle.height do
            if curnumber != 0 and puzzle.board[x][y][1] == 0 then
                add(curcolumn,curnumber)
                curnumber = 0
            end
            if puzzle.board[x][y][1] == 1 then
                curnumber += 1
            end
            y += 1
        end
        if curnumber != 0 then
            add(curcolumn,curnumber)
        end
        add(puzzle.columnnumbers,curcolumn)
        x += 1
    end

    band.objective = puzzle.y + (puzzle.height*8) - flr(rnd(puzzle.height*12)) - 20
    return 1
end

function draw_title()
    if menustate == 1 then
        --"nonograms" letter
        sspr(0,8,8,8,67,32,8*3,8*3,false,false)
        sspr(0,8,8,8,67+8*3,32,8*3,8*3,false,false)
        sspr(8,8,8*3,8,67,50,8*3*3,8*3,false,false)
        --line break
        rectfill(66+8*2*3,32+5,66+8*2*3+8,32+7,7)
        --numbers for the fake nonogram
        local titlerows = {"33","11","21","11","11"," 1"}
        local y = 15
        for row in all(titlerows) do
            print(row,1,y,7)
            y += 8
        end
        print("1   1   1\n1 3 2 1 1 5 1",11,1)
        --fake nonogram
        rectfill(9,13,10+7*8,14+6*8,5)
        map(0,0,9,13,7,6)
        rect(9,13,10+7*8,13+6*8,5)
        --rect(9,13,9+7*8,13+6*8,5)
        --gird
        posx = 10
        posy= 14
        for i=0, 7 do
            line(posx+i*8, posy, posx+i*8, posy+6*8-1,5)
            line(posx+i*8-1, posy, posx+i*8-1, posy+6*8-1,5)
        end
        for i=0, 6 do
            line(posx+1, posy+i*8, posx+7*8-2, posy+i*8,5)
            line(posx+1, posy-1+i*8, posx+7*8-2, posy-1+i*8,5)
        end
        --subtitle
        print_subtitle(70,"hltb")
        print_subtitle(80,"the unofficial")
        print_subtitle(88,"motionless")
        print_subtitle(96,"picture")
        print_subtitle(106,"the official")
        print_subtitle(114,"game")

        print("by uvehj",96,122,7)

    else
        local x = 8
        local y = 15
        local max_items_on_screen = flr((128-y)/(2*7))
        local levels = get_levels()
        local l = min(max(1, currentpuzzle-(max_items_on_screen/2)),#levels-max_items_on_screen+1)
        if (l > 1) print("\148",61,y-6,7)
        if (l + max_items_on_screen <= #levels) print("\131",61,122,7)
        for i=1,max_items_on_screen do
            local x_offset = x-7
            if wins[l] == 1 then
                print("\146",x_offset,y,7)
            elseif wins[l] == 2 then
                print("\146",x_offset,y,9)
            end
            level = levels[l]
            color(7)
            x_offset += 8
            if (flr(l/10)== 0) x_offset += 4
            if (l == currentpuzzle) color(8)
            print(l,x_offset,y)
            if (flr(l/10)~= 0) x_offset += 4
            x_offset += 6
            name = "??????"
            if (wins[l] ~= 0) name = level.name
            print(name,x_offset,y)
            print("by "..level.by,122-((#"by ")+#level.by-1)*4,y+7)
            
            color()
            l += 1
            y += 14
        end
    end
end

function print_subtitle(y, text)
    local x = 64 - #text*4
    rectfill(x,y,x + #text*8,y+8,5)
    local spriten = 0
    for letter in all(text) do
        spr(1+spriten*2,x,y)
        print(letter,x+3,y+2,0)
        rect(x,y,x + 8,y+8,5)
        x += 8
        spriten = abs(spriten-1)
        
    end
end

function draw_win()
    print("puzzle finished! mistakes: "..tostr(puzzle.mistakes),1,1,7)
    print(level.name,1,8,7)
    print("by "..level.by,6,15,7)
end

function draw_band()
    local y = 1
    local band_colors = {8,11,2,15,1,14,12}
    local band_width = 14
    for color in all(band_colors) do
        for i=0,band_width do
            line(0,band.position+y+i,128,band.position-15+y+i,color)
            if(band.position+y+i<7) line(63,0,65,0,color)
            i += 1
        end
        y+=band_width
    end
    while y <= 240 do
        line(0,band.position+y,128,band.position-15+y,12)
       y += 1
    end
end

function draw_board(posx,posy)
    --board
    rectfill(posx-1,posy-1,posx+puzzle.width*8,posy+puzzle.height*8,5)
    local x = 1
    while x <= puzzle.width do
        local y = 1
        while y <= puzzle.height do
            spr(get_tile_sprite(puzzle.board[x][y]),posx+(x-1)*8,posy+(y-1)*8)
            y += 1
        end
        x += 1
    end
    --row numbers
    local ynum = puzzle.y + 2
    for row in all(puzzle.rownumbers) do
        local xnum = puzzle.x + 1
        if(#row>0) do
            for i=#row, 1, -1 do
                xnum -= 6
                if (row[i] >= 10) xnum -= 4
                print(row[i],xnum,ynum,7)
                i-=1
            end
        end
        ynum += 8
    end
    --column numbers
    local xnum = puzzle.x + 2
    for column in all(puzzle.columnnumbers) do
        local ynum = puzzle.y - 1 - #column * 6
        for number in all(column) do
            local offset = 0
            if (number >= 10) offset -= 2
            print(number,xnum+offset,ynum,7)
            ynum += 6
        end
        xnum += 8
    end
    if (state==1) do
        for i=0, puzzle.width do
            line(posx+i*8, posy, posx+i*8, posy+puzzle.height*8-1,5)
            line(posx+i*8-1, posy, posx+i*8-1, posy+puzzle.height*8-1,5)
        end
        for i=0, puzzle.height do
            line(posx+1, posy+i*8, posx+puzzle.width*8-2, posy+i*8,5)
            line(posx+1, posy-1+i*8, posx+puzzle.width*8-2, posy-1+i*8,5)
            if ( i~=0 and i~=puzzle.height and i % 5 == 0) do 
                line(posx+1, posy+i*8, posx+puzzle.width*8-2, posy+i*8,12)
                line(posx+1, posy-1+i*8, posx+puzzle.width*8-2, posy-1+i*8,12)
            end  
        end
        for i=0, puzzle.width do
            if ( i~=0 and i~=puzzle.width and i % 5 == 0) do 
                line(posx+i*8, posy+1, posx+i*8, posy+puzzle.height*8-2,12)
                line(posx+i*8-1, posy+1, posx+i*8-1, posy+puzzle.height*8-2,12)
            end 
        end
    end
end
function draw_cursor(posx,posy)
    spr(7,posx+cursorpos[1]*8,posy+cursorpos[2]*8)
end
function get_tile_sprite_debug(tile)
        if tile[1] == 1 then --tile was colored
            if tile[3] == 1 then --tile is failed
                return 6
            else --colored not failed
                return 3
            end
        else --tile is not colored
           if tile[3] == 1 then --tile is failed
                return 5
            else --not colored not failed
                return 2
            end         
        end
end
function get_tile_sprite(tile)
    if tile[2] == 1 then --tile is uncovered
        if tile[1] == 1 then --tile was colored
            if tile[3] == 1 then --tile is failed
                return 6
            else --colored not failed
                return 3
            end
        else --tile is not colored
           if tile[3] == 1 then --tile is failed
                if(state == 1) do
                    return 5
                else
                    return 9
                end
            else --not colored not failed
                if(state == 1) do
                    return 2
                else
                    return 8
                end
            end         
        end
    else
        return 1
    end
end

function update_buttons_game()
    if btnp(0) then --left
        cursorpos[1] = max(cursorpos[1]-1,0)
    elseif btnp(1) then --right
        cursorpos[1] = min(cursorpos[1]+1,puzzle.width-1)
    elseif btnp(2) then --up
        cursorpos[2] = max(cursorpos[2]-1,0)
    elseif btnp(3) then --down
        cursorpos[2] = min(cursorpos[2]+1,puzzle.height-1)
    end
    if (btn(4) or btn(5)) and puzzle.board[cursorpos[1]+1][cursorpos[2]+1][2] == 0 and cooldown==0 then
        puzzle.board[cursorpos[1]+1][cursorpos[2]+1][2] = 1
        if puzzle.board[cursorpos[1]+1][cursorpos[2]+1][1] == 1 and btn(5) then
            puzzle.board[cursorpos[1]+1][cursorpos[2]+1][3] = 1
            puzzle.mistakes += 1
            sfx(0)
        elseif puzzle.board[cursorpos[1]+1][cursorpos[2]+1][1] == 0 and btn(4) then
            puzzle.board[cursorpos[1]+1][cursorpos[2]+1][3] = 1
            puzzle.mistakes += 1
            sfx(0)
        else
            sfx(1)
        end
    end
end

function update_buttons_menu()
    if(menustate == 1) then
        if btnp(5) then
            menustate = 2
            band.objective= band.defaults[menustate]
        end
    else
        if btnp(4) then
            menustate = 1
            band.objective= band.defaults[menustate]
        elseif btnp(3) and currentpuzzle<totalpuzzles then
            currentpuzzle += 1
            sfx(2)
        elseif btnp(2) and currentpuzzle > 1 then
            currentpuzzle -= 1
            sfx(2)
        elseif btnp(5) then
            sfx(2)
            state = load_level(currentpuzzle)
        end
    end
end

function update_buttons_finish()
    if (btnp(4)  or btnp(5)) and cooldown==0 then
        sfx(2)
        state = 0
        band.objective= band.defaults[menustate]
    end
end

function check_finished_and_autocomplete()
    local x = 1
    local y = 1
    local finished = true
    while x <= puzzle.width do
        y = 1
        local finishedcolumn = true
        while y <= puzzle.height do
            if puzzle.board[x][y][1] == 1 and puzzle.board[x][y][2] == 0 then --tile is colored but not revealed
                finished = false
                finishedcolumn = false
            end
            y += 1
        end
        if finishedcolumn == true then
            y = 1
            while y <= puzzle.height do
                puzzle.board[x][y][2] = 1
                puzzle.columnnumbers[x] = {}
                y += 1
            end
        end
        x += 1
    end
    x = 1
    y = 1
    while y <= puzzle.height do
        local x = 1
        local finishedrow = true
        while x <= puzzle.width do
            if puzzle.board[x][y][1] == 1 and puzzle.board[x][y][2] == 0 then --tile is colored but not revealed
                finished = false
                finishedrow = false
            end
            x += 1
        end
        if finishedrow == true then
            x = 1
            while x <= puzzle.width do
                puzzle.board[x][y][2] = 1
                puzzle.rownumbers[y] = {}
                x += 1
            end
        end
        y += 1
    end
    if finished == true then
        sfx(3)
        if puzzle.mistakes == 0 then
            wins[currentpuzzle] = max(2,wins[currentpuzzle])
        else
            wins[currentpuzzle] = max(1,wins[currentpuzzle])
        end
        dset(currentpuzzle,wins[currentpuzzle])
        cooldown = 1
        return 2
    else
        return 1
    end
end

function load_level(levelnum)
    local levels = get_levels();
    if(levelnum < 1 or levelnum>#levels) levelnum = 1
    cooldown = 0.5
    cursorpos = {0,0}
    level = levels[levelnum]
    currentpuzzle = levelnum
    return create_puzzle({level.position[1],level.position[2]},{level.map[1],level.map[2]},{level.map[3],level.map[4]})
end

function get_levels()
    return {
        {map={117,30,127,34},position={28,55},name="legally distinct bat",by="eimon"},
        {map={117,25,127,29},position={20,40},name="i vote for...",by="uvehj"},
        {map={117,0,127,8},position={25,40},name="maizy",by="alpha"},
        {map={117,9,127,17},position={30,40},name="rodney crawl",by="matt"},
        {map={117,18,127,24},position={24,25},name="twink sword",by="uvehj"},
        {map={7,0,18,11},position={20,25},name="bright eyes",by="gabriell"},
        {map={7,12,18,23},position={20,25},name="banhammer",by="gctuba"},
        {map={19,0,31,12},position={24,25},name="rodney selfie",by="matt"},
        {map={19,13,31,25},position={24,25},name="rodney",by="matt"},
        {map={7,24,18,35},position={26,27},name="fart",by="bohemu"},
        {map={7,36,18,47},position={24,25},name="tiamat's nap",by="bohemu"},
        {map={7,48,18,59},position={30,32},name="penne rigate",by="bohemu"},
        {map={32,0,43,11},position={25,26},name="green starfish",by="green starfish"},
        {map={109,11,116,20},position={35,30},name="stop right there",by="marisa"},
        {map={108,21,116,30},position={30,30},name="toilet",by="marisa"},
        {map={32,21,43,32},position={30,27},name="say, have you heard about",by="marisa"},
        {map={32,33,43,44},position={30,27},name="big baguette",by="marisa"},
        {map={0,6,5,16},position={45,27},name="honeymead",by="uvehj"},
        {map={108,31,116,35},position={35,50},name="baguette tip",by="uvehj"},
        {map={108,36,116,41},position={35,50},name="hollowed rodent",by="uvehj"}
    }
end
